{
    "name": "topwire/topwire",
    "type": "typo3-cms-extension",
    "description": "Topwire - Turbo for TYPO3",
    "homepage": "https://topwire.dev",
    "license": [
        "GPL-2.0-or-later"
    ],
    "authors": [
        {
            "name": "Helmut Hummel",
            "email": "typo3@helhum.io",
            "role": "Developer"
        }
    ],
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        },
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Topwire\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Topwire\\Tests\\": "Tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "typo3/cms-core": "^14.3.12"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.2",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpstan/phpstan-doctrine": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpunit/phpunit": "^11.5",
        "saschaegerer/phpstan-typo3": "^3",
        "typo3/cms-form": "*",
        "typo3/minimal": "*",
        "typo3/testing-framework": "^9.7"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "typo3/cms": {
            "extension-key": "topwire",
            "version": "2.0.1",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "scripts": {
        "check:cs-fixer": "php-cs-fixer fix --dry-run --diff",
        "check:phpstan": "phpstan analyse -c phpstan.14.3.neon",
        "fix:cs-fixer": "php-cs-fixer fix",
        "test:unit": "phpunit -c .Build/UnitTests.xml",
        "test:functional": "phpunit -c .Build/FunctionalTests.xml",
        "build": [
            "npm ci",
            "npm run build"
        ]
    }
}
